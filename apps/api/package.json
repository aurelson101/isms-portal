{
  "name": "@isms/api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc --noEmit && eslint src --max-warnings=0",
    "test": "vitest run src",
    "migrate": "prisma migrate deploy",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@prisma/client": "6.3.1",
    "bullmq": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "helmet": "8.0.0",
    "ldapts": "9.0.0",
    "prisma": "6.3.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "22.13.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
