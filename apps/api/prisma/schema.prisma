generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  QUARANTINED
}

enum WatermarkPosition {
  HEADER
  CENTER
  FOOTER
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

model DirectoryConnection {
  id                  String                 @id @default(uuid())
  name                String                 @unique
  domain              String
  primaryHost         String
  secondaryHost       String?
  port                Int                    @default(636)
  protocol            String                 @default("LDAPS")
  baseDn              String
  userBaseDn          String?
  groupBaseDn         String?
  bindDn              String
  encryptedBindSecret String
  userFilter          String                 @default("(objectClass=user)")
  groupFilter         String                 @default("(objectClass=group)")
  loginAttribute      String                 @default("sAMAccountName")
  usernameAttribute   String                 @default("mail")
  groupAttribute      String                 @default("cn")
  emailAttribute      String                 @default("mail")
  nestedGroups        Boolean                @default(true)
  syncIntervalMinutes Int                    @default(60)
  timeoutMs           Int                    @default(5000)
  retries             Int                    @default(2)
  enabled             Boolean                @default(false)
  caCertificateId     String?
  caCertificate       TrustedCaCertificate?  @relation(fields: [caCertificateId], references: [id])
  syncJobs            DirectorySyncJob[]
  groups              DirectoryGroup[]
  userSessions        DirectoryUserSession[]
  lastTestAt          DateTime?
  lastTestStatus      String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([enabled])
  @@index([caCertificateId])
}

model DirectoryUserSession {
  id                    String              @id @default(uuid())
  tokenHash             String              @unique
  username              String
  displayName           String
  groups                Json
  directoryConnectionId String
  directoryConnection   DirectoryConnection @relation(fields: [directoryConnectionId], references: [id], onDelete: Cascade)
  expiresAt             DateTime
  createdAt             DateTime            @default(now())
  lastUsedAt            DateTime            @default(now())

  @@index([username])
  @@index([expiresAt])
  @@index([directoryConnectionId])
}

model TrustedCaCertificate {
  id                String                @id @default(uuid())
  name              String
  subject           String
  issuer            String
  serialNumber      String
  fingerprintSha256 String                @unique
  validFrom         DateTime
  validTo           DateTime
  pem               String
  connections       DirectoryConnection[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([validTo])
}

model DirectoryGroup {
  id                    String               @id @default(uuid())
  name                  String               @unique
  distinguishedName     String               @unique
  description           String?
  memberCount           Int                  @default(0)
  active                Boolean              @default(true)
  lastSyncedAt          DateTime?
  directoryConnectionId String?
  directoryConnection   DirectoryConnection? @relation(fields: [directoryConnectionId], references: [id])
  accessRules           AccessRule[]
  ownedSpaces           DocumentSpace[]      @relation("SpaceOwnerGroup")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([directoryConnectionId])
}

model DirectorySyncJob {
  id           String              @id @default(uuid())
  connectionId String
  connection   DirectoryConnection @relation(fields: [connectionId], references: [id])
  status       String
  details      Json?
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?

  @@index([connectionId, startedAt])
  @@index([status])
}

model DocumentSpace {
  id           String             @id @default(uuid())
  slug         String             @unique
  nameFr       String
  nameEn       String
  categories   DocumentCategory[]
  documents    Document[]
  accessRules  AccessRule[]
  ownerGroupId String?
  ownerGroup   DirectoryGroup?    @relation("SpaceOwnerGroup", fields: [ownerGroupId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  @@index([ownerGroupId])
}

model DocumentCategory {
  id        String        @id @default(uuid())
  slug      String
  nameFr    String
  nameEn    String
  spaceId   String
  space     DocumentSpace @relation(fields: [spaceId], references: [id])
  documents Document[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@unique([spaceId, slug])
  @@index([spaceId])
}

model Document {
  id                String                 @id @default(uuid())
  spaceId           String
  space             DocumentSpace          @relation(fields: [spaceId], references: [id])
  categoryId        String?
  category          DocumentCategory?      @relation(fields: [categoryId], references: [id])
  status            DocumentStatus         @default(DRAFT)
  sensitive         Boolean                @default(false)
  watermarkPosition WatermarkPosition      @default(CENTER)
  viewCount         Int                    @default(0)
  downloadCount     Int                    @default(0)
  publishedAt       DateTime?
  translations      DocumentTranslation[]
  versions          DocumentVersion[]
  favorites         UserFavorite[]
  activities        UserDocumentActivity[]
  accessRequests    AccessRequest[]
  reports           DocumentReport[]
  reviews           DocumentReview[]
  retentionPolicy   RetentionPolicy?
  evidenceControls  ComplianceControl[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?

  @@index([spaceId, status])
  @@index([categoryId])
  @@index([publishedAt])
}

model UserFavorite {
  identity   String
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([identity, documentId])
  @@index([identity, createdAt])
  @@index([documentId])
}

model UserDocumentActivity {
  identity   String
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  action     String
  occurredAt DateTime @updatedAt

  @@id([identity, documentId, action])
  @@index([identity, occurredAt])
  @@index([documentId, occurredAt])
}

model SavedSearch {
  id        String   @id @default(uuid())
  identity  String
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identity, name])
  @@index([identity, updatedAt])
}

model AccessRequest {
  id            String    @id @default(uuid())
  identity      String
  documentId    String?
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  spaceId       String
  justification String
  status        String    @default("PENDING")
  decision      String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([identity, createdAt])
  @@index([status, createdAt])
  @@index([spaceId])
}

model DocumentReport {
  id         String    @id @default(uuid())
  identity   String
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reason     String
  message    String?
  status     String    @default("OPEN")
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([identity, createdAt])
  @@index([status, createdAt])
  @@index([documentId])
}

model UserNotification {
  id             String    @id @default(uuid())
  identity       String
  title          String
  message        String
  resourceType   String?
  resourceId     String?
  mandatory      Boolean   @default(false)
  readAt         DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([identity, createdAt])
  @@index([identity, readAt])
}

model DocumentTranslation {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  locale      String
  title       String
  description String?

  @@unique([documentId, locale])
  @@index([title])
}

model DocumentVersion {
  id                      String           @id @default(uuid())
  documentId              String
  document                Document         @relation(fields: [documentId], references: [id])
  locale                  String
  version                 Int
  storedFileId            String
  storedFile              StoredFile       @relation("SourceDocumentVersion", fields: [storedFileId], references: [id])
  distributedStoredFileId String?
  distributedStoredFile   StoredFile?      @relation("DistributedDocumentVersion", fields: [distributedStoredFileId], references: [id])
  createdAt               DateTime         @default(now())
  changeSummary           String?
  reviews                 DocumentReview[]

  @@unique([documentId, locale, version])
  @@index([storedFileId])
  @@index([distributedStoredFileId])
}

model DocumentAcknowledgement {
  id             String   @id @default(uuid())
  identity       String
  documentId     String
  versionId      String
  version        Int
  locale         String
  sha256         String
  acknowledgedAt DateTime @default(now())

  @@unique([identity, versionId])
  @@index([identity, acknowledgedAt])
  @@index([documentId, version])
}

model SecurityReport {
  id          String   @id @default(uuid())
  identity    String
  category    String
  urgency     String
  description String
  status      String   @default("OPEN")
  reference   String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, urgency, createdAt])
  @@index([identity, createdAt])
}

model RiskException {
  id                  String    @id @default(uuid())
  title               String
  owner               String
  justification       String
  compensatingControl String
  approver            String
  status              String    @default("PENDING")
  expiresAt           DateTime
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([owner, createdAt])
}

model SensitiveOperationApproval {
  id          String    @id @default(uuid())
  operation   String
  targetType  String
  targetId    String
  requestedBy String
  reason      String
  status      String    @default("PENDING")
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model StoredFile {
  id                  String            @id @default(uuid())
  objectKey           String            @unique
  originalName        String
  mimeType            String
  size                BigInt
  sha256              String
  sourceVersions      DocumentVersion[] @relation("SourceDocumentVersion")
  distributedVersions DocumentVersion[] @relation("DistributedDocumentVersion")
  scans               AntivirusScan[]
  createdAt           DateTime          @default(now())
}

model AccessRule {
  id                 String         @id @default(uuid())
  groupId            String
  group              DirectoryGroup @relation(fields: [groupId], references: [id])
  spaceId            String
  space              DocumentSpace  @relation(fields: [spaceId], references: [id])
  showMenu           Boolean        @default(false)
  read               Boolean        @default(false)
  search             Boolean        @default(false)
  preview            Boolean        @default(false)
  download           Boolean        @default(false)
  upload             Boolean        @default(false)
  edit               Boolean        @default(false)
  publish            Boolean        @default(false)
  archive            Boolean        @default(false)
  validFrom          DateTime?
  validUntil         DateTime?
  lifetime           Boolean        @default(true)
  lastCertifiedAt    DateTime?
  lastCertifiedBy    String?
  certificationDueAt DateTime?
  justification      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([groupId, spaceId])
  @@index([spaceId])
  @@index([validFrom, validUntil])
  @@index([lifetime, certificationDueAt])
}

model DocumentReview {
  id              String           @id @default(uuid())
  documentId      String
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId       String?
  version         DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  owner           String
  reviewer        String
  approver        String
  status          String           @default("PENDING")
  dueAt           DateTime
  decisionComment String?
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, dueAt])
  @@index([documentId, createdAt])
  @@index([versionId])
}

model ComplianceControl {
  id                   String    @id @default(uuid())
  framework            String
  reference            String
  title                String
  applicability        String    @default("APPLICABLE")
  implementationStatus String    @default("PLANNED")
  owner                String
  justification        String?
  evidenceDocumentId   String?
  evidenceDocument     Document? @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([framework, reference])
  @@index([applicability, implementationStatus])
  @@index([evidenceDocumentId])
}

model RetentionPolicy {
  id                String    @id @default(uuid())
  documentId        String    @unique
  document          Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  retentionUntil    DateTime?
  legalHold         Boolean   @default(false)
  reason            String
  destructionStatus String    @default("NONE")
  requestedBy       String?
  requestedAt       DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([legalHold, retentionUntil])
  @@index([destructionStatus])
}

model IncidentCase {
  id                String             @id @default(uuid())
  reference         String             @unique
  title             String
  severity          String
  status            String             @default("OPEN")
  owner             String
  occurredAt        DateTime
  rootCause         String?
  lessonsLearned    String?
  correctiveActions CorrectiveAction[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, severity, occurredAt])
}

model CorrectiveAction {
  id          String       @id @default(uuid())
  incidentId  String
  incident    IncidentCase @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  description String
  owner       String
  dueAt       DateTime
  status      String       @default("OPEN")
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([incidentId, status])
  @@index([status, dueAt])
}

model AdminSavedView {
  id        String   @id @default(uuid())
  identity  String
  section   String
  name      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identity, section, name])
  @@index([identity, section, updatedAt])
}

model AccessRuleTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  showMenu    Boolean  @default(false)
  read        Boolean  @default(false)
  search      Boolean  @default(false)
  preview     Boolean  @default(false)
  download    Boolean  @default(false)
  upload      Boolean  @default(false)
  edit        Boolean  @default(false)
  publish     Boolean  @default(false)
  archive     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AccessSnapshot {
  id        String   @id @default(uuid())
  label     String
  state     Json
  sha256    String
  signature String
  identity  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AuditEvent {
  id            String   @id @default(uuid())
  occurredAt    DateTime @default(now())
  identity      String
  ipAddress     String
  action        String
  resource      String
  result        String
  correlationId String
  details       Json?

  @@index([occurredAt])
  @@index([action, occurredAt])
  @@index([identity, occurredAt])
}

model ApplicationSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model UserPreference {
  identity      String    @id
  locale        String    @default("fr")
  viewMode      String    @default("list")
  density       String    @default("comfortable")
  textScale     Int       @default(100)
  highContrast  Boolean   @default(false)
  reducedMotion Boolean   @default(false)
  lastSeenAt    DateTime?
  updatedAt     DateTime  @updatedAt
}

model AdminAccount {
  id               String         @id @default(uuid())
  username         String         @unique
  displayName      String
  source           String         @default("LOCAL")
  passwordHash     String?
  profilePhoto     String?
  mfaSecret        String?
  mfaEnabled       Boolean        @default(false)
  active           Boolean        @default(true)
  primary          Boolean        @default(false)
  justification    String?
  validFrom        DateTime?
  validUntil       DateTime?
  lastAuthorizedAt DateTime?
  lastReviewedAt   DateTime?
  reviewDueAt      DateTime?
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  sessions         AdminSession[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([source, active])
  @@index([active, validFrom, validUntil])
}

model AdminDirectoryGroup {
  id                String    @id @default(uuid())
  name              String    @unique
  distinguishedName String    @unique
  active            Boolean   @default(true)
  justification     String
  validFrom         DateTime?
  validUntil        DateTime?
  lastAuthorizedAt  DateTime?
  lastReviewedAt    DateTime?
  reviewDueAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([active, name])
  @@index([active, validUntil])
  @@index([active, validFrom, validUntil])
}

model AdminSession {
  id             String       @id @default(uuid())
  tokenHash      String       @unique
  adminAccountId String
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime     @default(now())
  sourceIp       String?
  userAgent      String?

  @@index([adminAccountId])
  @@index([expiresAt])
}

model AnnualIncidentReport {
  id                String   @id @default(uuid())
  year              Int      @unique
  totalIncidents    Int
  criticalIncidents Int
  resolvedIncidents Int
  summary           String
  lessonsLearned    String?
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, year])
}

model AntivirusScan {
  id           String     @id @default(uuid())
  storedFileId String
  storedFile   StoredFile @relation(fields: [storedFileId], references: [id])
  status       ScanStatus @default(PENDING)
  signature    String?
  scannedAt    DateTime?

  @@index([storedFileId, status])
}
