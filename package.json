{
  "name": "isms-portal",
  "private": true,
  "version": "0.9.63",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @isms/api && npm run build -w @isms/web",
    "postinstall": "npm exec -w @isms/api -- prisma generate --schema prisma/schema.prisma",
    "i18n:check": "node --test scripts/check-i18n.test.mjs && node scripts/check-i18n.mjs",
    "lint": "npm run i18n:check && npm run lint -w @isms/api && npm run lint -w @isms/web",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,css}\"",
    "test": "node --test scripts/archive-compatibility.test.mjs && npm run test -w @isms/api && npm run test -w @isms/web && npm run test:mip",
    "test:mip": "vitest run integrations/mip-reader/boundary.spec.ts --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "./scripts/test-e2e-isolated.sh",
    "test:performance": "./scripts/test-performance-functional.sh",
    "diagnose": "./scripts/diagnose.sh",
    "verify": "npm run lint && npm run format:check && npm test && npm exec knip && npm audit --audit-level=moderate",
    "migrate": "npm run migrate -w @isms/api",
    "seed": "npm run seed -w @isms/api"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1",
      "archiver": "5.3.2",
      "unzipper": "0.12.3"
    },
    "mammoth": {
      "argparse": "2.0.1"
    },
    "@nestjs/swagger@11.4.6": {
      "js-yaml": "5.4.1"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "@xmldom/xmldom": "0.8.15",
    "fflate": "0.8.3",
    "multer": "2.5.0",
    "body-parser": "2.4.0",
    "qs": "6.16.1",
    "minimatch": "11.0.1",
    "archiver-utils": {
      "glob": "14.0.2"
    }
  },
  "knip": {
    "workspaces": {
      ".": {
        "entry": [
          "tests/readme-screenshots.config.ts",
          "tests/storage-ui.config.ts"
        ]
      },
      "apps/api": {
        "entry": [
          "src/main.ts",
          "src/worker.ts",
          "prisma/prepare-migrations.js",
          "prisma/performance-seed.js",
          "prisma/verify-storage.js"
        ],
        "ignoreBinaries": [
          "openssl"
        ]
      },
      "apps/web": {
        "entry": [
          "app/**/*.tsx"
        ],
        "ignoreDependencies": [
          "sharp"
        ]
      }
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.55.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "knip": "^6.29.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.6.2",
    "prisma": "6.3.1",
    "qs": "6.16.1",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.12"
  }
}
