NODE_ENV=production
PUBLIC_URL=https://isms.example.com
POSTGRES_DB=isms
POSTGRES_USER=isms
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://isms:change-me@postgres:5432/isms
REDIS_URL=redis://redis:6379
# 0 preserves audit history; set a positive duration only after retention approval.
AUDIT_RETENTION_DAYS=0
DOCUMENT_STORAGE_PATH=/data/documents
ENCRYPTION_KEY=replace-with-32-byte-base64-key
ISMS_ADMIN_GROUPS=ISMS-ADMINS,ISMS-SUPER-ADMINS
TRUSTED_PROXY_CIDRS=172.16.0.0/12
SSO_LOGIN_URL=
SSO_PILOT_URL=
SSO_LOGIN_VERIFIED=false
SSO_LOGOUT_URL=
SSO_DIRECTORY_GROUP_ENRICHMENT=true
SSO_DIRECTORY_CACHE_TTL_SECONDS=300
SSO_DIRECTORY_NEGATIVE_CACHE_TTL_SECONDS=30
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
SSO_MAILBOX_POLICY_ENABLED=false
SSO_MAILBOX_ALLOWED_DOMAINS=
SSO_MAILBOX_CERTIFICATE_HOST_FILE=./secrets/sso-mailbox-certificate.pem
SSO_MAILBOX_PRIVATE_KEY_HOST_FILE=./secrets/sso-mailbox-private-key.pem
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_REDIS_PASSWORD=
OAUTH2_PROXY_REDIRECT_URL=https://isms.example.com/oauth2/callback
# Optional MIP reader pilot; see docs/mip-reader.md before enabling.
MIP_READER_ENABLED=false
MIP_TENANT_ID=
MIP_CLIENT_ID=
MIP_ALLOWED_DOMAINS=
MIP_API_KEY_HOST_FILE=./secrets/mip-api-key.txt
MIP_CERTIFICATE_HOST_FILE=./secrets/mip-certificate.pem
MIP_PRIVATE_KEY_HOST_FILE=./secrets/mip-private-key.pem
COOKIE_SECURE=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=Administrateur ISMS
INITIAL_ADMIN_PASSWORD=replace-with-generated-strong-password
NEXT_PUBLIC_API_URL=/api
