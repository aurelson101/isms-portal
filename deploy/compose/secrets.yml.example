services:
  api:
    environment:
      DATABASE_URL_FILE: /run/secrets/database_url
      REDIS_URL_FILE: /run/secrets/redis_url
      MINIO_ACCESS_KEY_FILE: /run/secrets/minio_access_key
      MINIO_SECRET_KEY_FILE: /run/secrets/minio_secret_key
      ENCRYPTION_KEY_FILE: /run/secrets/encryption_key
    secrets: [database_url, redis_url, minio_access_key, minio_secret_key, encryption_key]

  worker:
    environment:
      DATABASE_URL_FILE: /run/secrets/database_url
      REDIS_URL_FILE: /run/secrets/redis_url
      MINIO_ACCESS_KEY_FILE: /run/secrets/minio_access_key
      MINIO_SECRET_KEY_FILE: /run/secrets/minio_secret_key
      ENCRYPTION_KEY_FILE: /run/secrets/encryption_key
    secrets: [database_url, redis_url, minio_access_key, minio_secret_key, encryption_key]

  postgres:
    environment:
      POSTGRES_PASSWORD: !reset null
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
    secrets: [postgres_password]

  minio:
    environment:
      MINIO_ROOT_PASSWORD: !reset null
      MINIO_ROOT_PASSWORD_FILE: /run/secrets/minio_secret_key
    secrets: [minio_secret_key]

secrets:
  database_url: {file: ./secrets/database_url}
  postgres_password: {file: ./secrets/postgres_password}
  redis_url: {file: ./secrets/redis_url}
  minio_access_key: {file: ./secrets/minio_access_key}
  minio_secret_key: {file: ./secrets/minio_secret_key}
  encryption_key: {file: ./secrets/encryption_key}
