services:
  api:
    environment:
      DATABASE_URL_FILE: /run/secrets/database_url
      REDIS_URL_FILE: /run/secrets/redis_url
      ENCRYPTION_KEY_FILE: /run/secrets/encryption_key
    secrets: [database_url, redis_url, encryption_key]

  worker:
    environment:
      DATABASE_URL_FILE: /run/secrets/database_url
      REDIS_URL_FILE: /run/secrets/redis_url
      ENCRYPTION_KEY_FILE: /run/secrets/encryption_key
    secrets: [database_url, redis_url, encryption_key]

  postgres:
    environment:
      POSTGRES_PASSWORD: !reset null
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
    secrets: [postgres_password]

secrets:
  database_url: {file: ./secrets/database_url}
  postgres_password: {file: ./secrets/postgres_password}
  redis_url: {file: ./secrets/redis_url}
  encryption_key: {file: ./secrets/encryption_key}
